{
  "_readme": [
    "Model catalogue. Edit this file (or Settings -> Model Hub -> Edit catalogue) to add,",
    "rename or reroute models WITHOUT touching code. The app hot-reloads it.",
    "",
    "openness:  'open'   = weights downloadable, can run locally and free",
    "           'partial'= some variants/older versions open",
    "           'closed' = API only, no weights",
    "",
    "routes[].verified:  false means the endpoint id is a best guess. Vendors rename",
    "preview endpoints often. A 404 from the app means: fix the endpoint here.",
    "Browse real ids at fal.ai/models and replicate.com/explore."
  ],

  "option_presets": {
    "video_basic": {
      "aspect_ratio": {"type": "choice", "choices": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9"], "default": "16:9"},
      "duration": {"type": "int", "default": 5, "min": 2, "max": 30, "label": "Seconds"},
      "resolution": {"type": "choice", "choices": ["480p", "720p", "1080p"], "default": "720p"},
      "extra_json": {"type": "text", "default": "", "label": "Extra JSON payload (merged verbatim)"}
    },
    "video_audio": {
      "aspect_ratio": {"type": "choice", "choices": ["16:9", "9:16", "1:1"], "default": "16:9"},
      "duration": {"type": "int", "default": 5, "min": 2, "max": 30, "label": "Seconds"},
      "resolution": {"type": "choice", "choices": ["480p", "720p", "1080p"], "default": "720p"},
      "generate_audio": {"type": "bool", "default": true, "label": "Native audio"},
      "extra_json": {"type": "text", "default": "", "label": "Extra JSON payload (merged verbatim)"}
    },
    "image_basic": {
      "aspect_ratio": {"type": "choice", "choices": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9"], "default": "1:1"},
      "num_images": {"type": "int", "default": 1, "min": 1, "max": 4, "label": "Images"},
      "extra_json": {"type": "text", "default": "", "label": "Extra JSON payload (merged verbatim)"}
    },
    "lipsync": {
      "extra_json": {"type": "text", "default": "", "label": "Extra JSON payload (merged verbatim)"}
    }
  },

